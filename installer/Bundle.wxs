<!--
  The Nyatch setup program (WiX 5 Burn): Nyatch-Setup-<version>.exe, the file people download.
  Built by ..\build.ps1 -Exe after Package.wxs: it carries Nyatch-<version>.msi inside it.

  Opened by a double-click, it shows the MSI's own pages (Welcome, folder, options, Finish); the
  setup program itself shows nothing of its own. The updater runs it silently:
    Nyatch-Setup-<version>.exe /quiet /norestart /log <file>
  AUTOLAUNCH=1 on its command line starts Nyatch when it is done, as the MSI's own property does.

  Apps & features lists the setup program (one "Nyatch"); the MSI inside it is not listed twice.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Nyatch"
          Manufacturer="Arkhins"
          Version="$(var.Version)"
          UpgradeCode="4D6A550C-425C-44B2-9FB8-946E12D9FFCB"
          IconSourceFile="$(var.IconFile)"
          AboutUrl="https://nyatch.arkhins.com"
          HelpUrl="https://nyatch.arkhins.com">
    <BootstrapperApplication>
      <!-- No pages of its own: the MSI's pages are the setup's pages. -->
      <bal:WixStandardBootstrapperApplication Theme="none" />
    </BootstrapperApplication>

    <Variable Name="AUTOLAUNCH" Value="0" bal:Overridable="yes" />

    <Chain>
      <MsiPackage SourceFile="$(var.MsiFile)" bal:DisplayInternalUICondition="1">
        <MsiProperty Name="AUTOLAUNCH" Value="[AUTOLAUNCH]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
