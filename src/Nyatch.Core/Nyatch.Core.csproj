<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nyatch.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The island's settings, as its C++ code declares them. -->
    <EmbeddedResource Include="settings.schema.yaml" LogicalName="settings.schema.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.11.0" />
  </ItemGroup>

</Project>
