<Project Sdk="Microsoft.NET.Sdk">

  <!-- The theme editor: a window Nyatch opens from its Theme page, to make and edit themes (.nyatch). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Nyatch.ThemeEditor</RootNamespace>
    <!-- Windows 11's look for WPF controls (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The theme format, the slot list and the theme maker are Nyatch's own, so themes made here are exactly what it installs. -->
    <ProjectReference Include="..\Nyatch.Core\Nyatch.Core.csproj" />
  </ItemGroup>

</Project>
