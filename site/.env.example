# nyatch.arkhins.com: the settings the site and its API read.
#
# Copy this file to .env.local for running the site on this PC (git ignores .env.local), and put the
# same names and values in Vercel › Project › Settings › Environment Variables for the live site.
# Never commit real values.

# ---------- Themes: the database (Neon) ----------

# Neon › your project › Dashboard › Connection string (choose "Pooled connection").
# Looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------- Themes: the files (Cloudflare R2) ----------

# Cloudflare › R2 › Overview: "Account ID" (right-hand side).
R2_ACCOUNT_ID=

# Cloudflare › R2 › Manage R2 API Tokens › Create API token: permission "Object Read & Write",
# limited to the bucket below. Copy both values when it is created (the secret is shown once).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The one bucket, kept private (no public access, no r2.dev address): approved themes are reached
# through the site, which hands out a download link that works for a few minutes.
R2_BUCKET=nyatch-object-storage

# Its folders: Nyatch's releases (the installers, checksums and signatures), themes waiting for review,
# and approved themes with their covers.
R2_RELEASES_PREFIX=releases/
R2_PENDING_PREFIX=pending/
R2_APPROVED_PREFIX=approved/

# ---------- The admin page (nyatch.arkhins.com/admin) ----------

# The password for the admin page, where themes are approved or rejected. Long and random.
ADMIN_PASSWORD=

# Signs the admin page's sign-in cookie. Long and random; changing it signs you out everywhere.
SESSION_SECRET=

# ---------- Telling you a theme is waiting (optional: one or both) ----------

# Email, through Amazon SES. (Named SES_…, not AWS_…: Vercel keeps the AWS_ names for itself.)
# AWS › IAM › Users › Create user › attach a policy allowing only "ses:SendEmail" › Security credentials ›
# Create access key ("Application running outside AWS").
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# The region your SES is set up in (AWS › Amazon SES, top right), for example ap-south-1 or us-east-1.
SES_REGION=
# The sender: an address on a domain verified in SES › Identities (for example themes@arkhins.com).
SES_FROM=
# Where the "a theme is waiting" email goes. While SES is in its sandbox, this address must be verified too.
NOTIFY_EMAIL=

# Telegram: a bot from @BotFather, and your chat id (message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Releases ----------

# The releases are in Neon (DATABASE_URL) and R2 (above): build.ps1 -Release puts them there, the site
# serves them. Nothing else is needed; GitHub is not read by the site any more.
